{%- set d = cat[locale] -%}
{%- set preselect = d.preselect -%}

<nav class="crumbs" aria-label="{{ t.nav.breadcrumb }}">
  <div class="container">
    <ol>
      <li><a href="{{ homeUrl | url }}">{{ t.nav.home }}</a></li>
      <li><a href="{{ (homeUrl + '#categories') | url }}">{{ t.nav.products }}</a></li>
      <li aria-current="page">{{ d.nav }}</li>
    </ol>
  </div>
</nav>

<section class="page-hero">
  <div class="container page-hero__inner">
    <div class="page-hero__text reveal">
      <h1 class="page-hero__title">{{ d.h1 }}</h1>
      <p class="page-hero__lead">{{ d.lead }}</p>
      <a href="#quote" class="btn btn--gold">{{ d.cta }}</a>
    </div>
    <div class="page-hero__media reveal" data-delay="120">
      <img src="{{ cat.image | url }}" alt="{{ d.alt }}" fetchpriority="high" decoding="async">
    </div>
  </div>
</section>

<article class="section prose-wrap">
  <div class="container prose">
    {%- for s in d.sections %}
    <section class="prose__block reveal">
      <h2>{{ s.title }}</h2>
      {%- for p in s.body %}
      <p>{{ p }}</p>
      {%- endfor %}

      {%- if s.list %}
      <ul class="pill-list">
        {%- for item in s.list %}<li><svg class="ico ico--xs"><use href="#check-circle"></use></svg>{{ item }}</li>{% endfor %}
      </ul>
      {%- endif %}

      {%- if s.steps %}
      <ol class="proc">
        {%- for step in s.steps %}
        <li class="proc__item">
          <span class="proc__num">{{ loop.index }}</span>
          <div><h3>{{ step.title }}</h3><p>{{ step.text }}</p></div>
        </li>
        {%- endfor %}
      </ol>
      {%- endif %}
    </section>
    {%- endfor %}

    <section class="prose__block faq reveal">
      <h2>{{ "Frequently Asked Questions" if locale == "en" else "Questions fréquentes" }}</h2>
      {%- for f in d.faq %}
      <details class="faq__item">
        <summary>{{ f.q }}</summary>
        <p>{{ f.a }}</p>
      </details>
      {%- endfor %}
    </section>

    <aside class="page-cta reveal">
      <h2>{{ t.categories.help.title }}</h2>
      <p>{{ t.categories.help.text }}</p>
      <a href="#quote" class="btn btn--gold">{{ d.cta }}</a>
    </aside>

    <nav class="sibling-nav" aria-label="{{ t.footer.products_title }}">
      <h2>{{ t.footer.products_title }}</h2>
      <ul>
        {%- for c in categories %}{% if c.key != cat.key %}
        <li><a href="{{ ('/' + locale + '/' + c[locale].slug + '/') | url }}">
          <svg class="ico"><use href="#{{ c.icon }}"></use></svg>
          <strong>{{ c[locale].nav }}</strong>
          <em>{{ c[locale].card_text }}</em>
        </a></li>
        {%- endif %}{% endfor %}
      </ul>
    </nav>
  </div>
</article>

{% include "partials/quote-form.njk" %}
{% include "partials/brands.njk" %}

<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": d.h1,
      "description": d.meta_description,
      "serviceType": d.nav,
      "provider": { "@type": "Organization", "name": site.company.legal_name, "url": (homeUrl | absUrl) },
      "areaServed": ["AE", "KW", "SA", "QA", "OM", "BH", "IQ"],
      "url": (selfUrl | absUrl)
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": t.nav.home, "item": (homeUrl | absUrl) },
        { "@type": "ListItem", "position": 2, "name": d.nav, "item": (selfUrl | absUrl) }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": (d.faq | faqSchema)
    }
  ]
} | jsonld | safe }}</script>
