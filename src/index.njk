permalink: /index.html
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>UAE Sourcing — Export Partner</title>
<link rel="canonical" href="{{ "/en/" | absUrl }}">
<link rel="alternate" hreflang="en" href="{{ "/en/" | absUrl }}">
<link rel="alternate" hreflang="fr" href="{{ "/fr/" | absUrl }}">
<link rel="alternate" hreflang="x-default" href="{{ "/en/" | absUrl }}">
<meta http-equiv="refresh" content="0; url={{ '/en/' | url }}">
<script>
/* Sends French-speaking visitors to the French site. The meta refresh above is
   the fallback for no-JS; a real 302 comes from _redirects once the site moves
   to a host that supports it. */
(function () {
  var langs = navigator.languages || [navigator.language || ""];
  var wantsFr = Array.prototype.some.call(langs, function (l) {
    return String(l).toLowerCase().indexOf("fr") === 0;
  });
  location.replace(wantsFr ? {{ ("/fr/" | url) | dump | safe }} : {{ ("/en/" | url) | dump | safe }});
})();
</script>
</head>
<body><p><a href="{{ '/en/' | url }}">Continue in English</a> — <a href="{{ '/fr/' | url }}">Continuer en français</a></p></body>
</html>
